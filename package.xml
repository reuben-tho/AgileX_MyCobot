<?xml version="1.0"?>
<package format="3">
  <name>limo_mycobot_control</name>
  <version>0.1.0</version>
  <description>Combined RViz slider control for an AgileX LIMO with a MyCobot 280 M5 arm.</description>
  <maintainer email="maintainer@example.com">Project Maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>mycobot_description</exec_depend>
  <exec_depend>limo_base</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
